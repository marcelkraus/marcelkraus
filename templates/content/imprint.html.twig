{% extends 'base.html.twig' %}

{% block title %}Impressum · Marcel Kraus{% endblock %}
{% block meta_description %}Impressum von Marcel Kraus, Senior Softwareentwickler iOS/Web aus Erftstadt bei Köln.{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex,follow">{% endblock %}

{% block content %}
    <article class="card card-padded">
        <div class="max-w-3xl hyphens-auto">
            {{ include('partials/_legal_head.html.twig', { title: 'Impressum', date: '20. Oktober 2026' }, with_context = false) }}

            <div class="mt-12 space-y-12">
                <section>
                    <h2 class="text-t3 font-bold">Angaben gemäß § 5 DDG</h2>
                    <div class="mt-4">
                        <p>Marcel Kraus</p>
                        <p>Bonner Str. 88</p>
                        <p>50374 Erftstadt</p>
                        <p>Deutschland</p>
                    </div>
                </section>

                <section>
                    <h2 class="text-t3 font-bold">Kontakt</h2>
                    <dl class="mt-4 space-y-2">
                        <div class="flex gap-4"><dt class="w-24 shrink-0 text-muted">E-Mail</dt><dd class="min-w-0 wrap-anywhere">{{ include('partials/_legal_mail_address.html.twig') }}<br>Erstkontakt bitte über das <a href="{{ path('app_contact_page') }}" class="link">Kontaktformular</a> oder per E-Mail</dd></div>
                    </dl>
                </section>

                <section>
                    <h2 class="text-t3 font-bold">Umsatzsteuer</h2>
                    <p class="mt-4">Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br>DE225346678</p>
                </section>

                <section>
                    <h2 class="text-t3 font-bold">Redaktionell verantwortlich</h2>
                    <p class="mt-4">Marcel Kraus, Anschrift wie oben.</p>
                </section>

                <section>
                    <h2 class="text-t3 font-bold">Verbraucherstreitbeilegung</h2>
                    <p class="mt-4">Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
                </section>
            </div>
        </div>
    </article>
{% endblock %}
