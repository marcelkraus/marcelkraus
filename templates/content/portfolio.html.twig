{# The towers stand in reverse brand order, so the higher one comes first for a
   keyboard and a screen reader. #}
{% extends 'base.html.twig' %}

{% block title %}Portfolio · Marcel Kraus{% endblock %}
{% block meta_description %}Portfolio von Marcel Kraus, Senior Softwareentwickler iOS/Web aus Erftstadt bei Köln und dem Menschen hinter krausgebaut und krausgedruckt.{% endblock %}

{% block cover %}
    {{ include('partials/_cover_card.html.twig') }}
{% endblock %}

{% block content %}
    <div class="towers">
        {% for brand in brands|reverse %}
            {{ include('partials/_tower.html.twig', { brand: brand }, with_context = false) }}
        {% endfor %}
    </div>

    <section id="works" class="card works" aria-labelledby="works-title">
        <h2 id="works-title" class="lead-in works-title">Außerdem von mir</h2>
        <div class="cells cells-3">
            {% for work in works %}
                {{ include('partials/_work.html.twig', { work: work }, with_context = false) }}
            {% endfor %}
            <div class="works-closing">
                <h3 class="text-t3 font-bold">Passt das zu Ihnen?</h3>
                <p class="text-muted">Erzählen Sie mir von Ihrer Stelle – ich freue mich auf Ihre Nachricht.</p>
                {{ include('partials/_link.html.twig', { href: path('app_contact_page'), label: 'Nachricht schreiben', to: 'page', class: 'button button-solid' }, with_context = false) }}
            </div>
        </div>
    </section>
{% endblock %}
