{# The towers stand in brand order: krausgebaut, the higher one, comes first for
   a keyboard and a screen reader. #}
{% extends 'base.html.twig' %}

{% block structured_data %}
    {%- set person = {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Marcel Kraus',
        jobTitle: 'Softwareentwickler iOS/Web und Internet-, IT- & 3D-Druck-Dienstleister',
        sameAs: profiles|map(profile => profile.url),
        brand: brands|map(brand => { '@type': 'Brand', name: brand.name, url: brand.url }),
    } -%}
    <script type="application/ld+json">{{ person|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block cover %}
    {% embed 'partials/_cover_card.html.twig' %}
        {% block more %}<p class="cover-lead">Nach 25 Jahren nebenberuflicher Tätigkeit stehe ich Ihnen mit krausgebaut ab sofort hauptberuflich als zuverlässiger Partner rund um Ihre <span class="whitespace-nowrap">Internet- &amp;</span> IT-Anforderungen zur Seite. Mit krausgedruckt darüber hinaus für alle Ihre Anfragen im <span class="whitespace-nowrap">3D-Druck</span>-Bereich.</p>{% endblock %}
    {% endembed %}
{% endblock %}

{% block content %}
    <div class="towers">
        {% for brand in brands %}
            {{ include('partials/_tower.html.twig', { brand: brand }, with_context = false) }}
        {% endfor %}
    </div>

    <section id="works" class="card works" aria-labelledby="works-title">
        <header class="card-head works-head">
            <p class="lead-in">Außerdem von mir</p>
            <h2 id="works-title" class="text-t2 font-bold">Aus meinem Portfolio</h2>
        </header>
        <div class="cells cells-3">
            {% for work in works %}
                {{ include('partials/_work.html.twig', { work: work }, with_context = false) }}
            {% endfor %}
            <div class="works-closing">
                <h3 class="text-t3 font-bold">Auch Bedarf an einer App oder einer Website?</h3>
                <p class="text-muted">Erzählen Sie mir von Ihrem Projekt – ich freue mich auf Ihre Nachricht.</p>
                {{ include('partials/_link.html.twig', { href: 'https://www.krausgebaut.de/#kontakt', label: 'Nachricht schreiben', to: 'out', class: 'button button-solid' }, with_context = false) }}
            </div>
        </div>
    </section>
{% endblock %}
