{# Hand-rolled contact form. Expects: errors (map path→message),
   old (submitted values), contact_timestamp + contact_timestamp_signature (signed anti-spam timestamp). #}
{% import _self as field %}

{% macro label(name, text, required) %}
    <label for="f_{{ name }}" class="lead-in">{{ text }}{% if required %} <span aria-hidden="true">*</span>{% endif %}</label>
{% endmacro %}

{% macro input(name, text, old, errors, options) %}
    {% set options = options|default({}) %}
    {% set error = errors[name]|default(null) %}
    {% set required = options.required|default(false) %}
    <div class="field">
        {{ _self.label(name, text, required) }}
        <input type="{{ options.type|default('text') }}" id="f_{{ name }}" name="{{ name }}" value="{{ old[name]|default('') }}"
               {% if options.autocomplete is defined %}autocomplete="{{ options.autocomplete }}"{% endif %}
               {% if required %}aria-required="true"{% endif %}
               {% if error %}aria-invalid="true" aria-describedby="e_{{ name }}"{% endif %}>
        {% if error %}<p id="e_{{ name }}" class="field-error">{{ error }}</p>{% endif %}
    </div>
{% endmacro %}

<form method="post" action="{{ path('app_contact') }}" class="contact-form" novalidate{% if focus is defined and focus %} data-error-focus="{{ focus }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
    <input type="hidden" name="ts" value="{{ contact_timestamp }}">
    <input type="hidden" name="ts_sig" value="{{ contact_timestamp_signature }}">

    {# Honeypot: hidden from users, tempting to bots. A neutral field name
       that browser autofill is unlikely to populate for a real visitor. #}
    <div class="sr-only" aria-hidden="true">
        <label for="f_website">Dieses Feld bitte leer lassen</label>
        <input type="text" id="f_website" name="website" tabindex="-1" autocomplete="off">
    </div>

    {% if errors.form is defined %}
        <p class="form-alert field-wide" role="alert">{{ errors.form }}</p>
    {% endif %}

    {{ field.input('name', 'Name', old, errors, { required: true, autocomplete: 'name' }) }}
    {{ field.input('company', 'Firma', old, errors, { autocomplete: 'organization' }) }}
    {{ field.input('email', 'E-Mail', old, errors, { required: true, type: 'email', autocomplete: 'email' }) }}
    {{ field.input('phone', 'Telefon', old, errors, { type: 'tel', autocomplete: 'tel' }) }}

    <div class="field field-wide">
        {{ field.label('message', 'Nachricht', true) }}
        <textarea id="f_message" name="message" rows="5" aria-required="true"
                  {% if errors.message is defined %}aria-invalid="true" aria-describedby="e_message"{% endif %}
                  placeholder="Worum geht es? Eine Stelle, ein Projekt, ein erstes Gespräch – schreiben Sie einfach ein paar Sätze.">{{ old.message|default('') }}</textarea>
        {% if errors.message is defined %}<p id="e_message" class="field-error">{{ errors.message }}</p>{% endif %}
    </div>

    <button type="submit" class="button button-solid">Nachricht senden</button>

    <p class="field-wide font-mono text-m2 text-muted">Pflichtfelder * · Mit dem Absenden stimmen Sie meiner <a class="underline" href="{{ path('app_data_privacy') }}">Datenschutzerklärung</a> zu.</p>
</form>
