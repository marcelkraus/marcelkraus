{# Params: brand (an entry of brands.json). The mark is inlined; see
   assets/README.md. #}
<article class="tower" data-brand="{{ brand.colorToken }}">
    <span class="tower-mark" aria-hidden="true">{{ source('@marks/' ~ brand.mark) }}</span>
    <h2 class="tower-name">{{ brand.name }}</h2>
    <p class="tower-claim text-t3">{% for line in brand.claim %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {{ include('partials/_link.html.twig', { href: brand.url, label: brand.domain, to: 'out', class: 'button tower-link' }, with_context = false) }}
</article>
