{# Params: href, label, to ('out' ↗, 'page' →, 'down' ↓), class (default 'link'),
   subject (read after the label by a screen reader only). #}
{%- set arrows = { down: '↓', out: '↗', page: '→' } -%}
<a class="{{ class|default('link') }}" href="{{ href }}"{% if to == 'out' %} target="_blank" rel="noopener"{% endif %}>{{ label }}{% if subject is defined %}<span class="sr-only"> {{ subject }}</span>{% endif %} <span class="link-arrow" aria-hidden="true">{{ arrows[to] }}</span>{% if to == 'out' %}<span class="sr-only"> – öffnet in neuem Tab</span>{% endif %}</a>
