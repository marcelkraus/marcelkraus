{# The frame of every page: the facade as the ground, the header with the
   logo and the tabs, the footer with the tridents. The active tab follows
   the path rather than the route name, so the contact page re-rendered by
   the POST that handles its form keeps its tab; a legal page matches none
   and leaves all three inactive. #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block meta_robots %}<meta name="robots" content="index,follow">{% endblock %}
    <meta name="description" content="{% block meta_description %}Marcel Kraus, Senior Softwareentwickler iOS/Web aus Erftstadt bei Köln, selbstständig seit 2002. Lebenslauf, Werdegang und Kontakt.{% endblock %}">
    <title>{% block title %}Marcel Kraus · Senior Softwareentwickler iOS/Web aus Erftstadt bei Köln{% endblock %}</title>

    {# Favicons. Three files, all derived from the master artwork: the SVG scales
       to any size a browser asks for, the ICO carries 16 and 32 px and answers
       the implicit /favicon.ico request, the PNG covers the iOS home screen.
       The SVG must keep its width/height—without them it has no intrinsic
       size, a browser rasterizes it into a default box and scales that into the
       tab slot, which leaves a pale rim around the tile. #}
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">

    <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

    {# Open Graph / social sharing. #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="marcelkraus.de">
    <meta property="og:locale" content="de_DE">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    <meta property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset('images/sharing.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost ~ asset('images/sharing.jpg') }}">

    {% block meta %}{% endblock %}
    {% block structured_data %}{% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="/css/output.css">
    {% endblock %}

    {% if app.environment == 'prod' %}
        {# Privacy-first analytics: self-hosted Matomo (SiteId 10), run
           cookieless via disableCookies. Nothing is stored on or read from the
           visitor's device, so no consent banner is required. Production only—
           local and CI traffic must not pollute the statistics. #}
        <script>
            var _paq = window._paq = window._paq || [];
            _paq.push(['disableCookies']);
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://analytics.krausgebaut.de/";
                _paq.push(['setTrackerUrl', u + 'matomo.php']);
                _paq.push(['setSiteId', '10']);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
            })();
        </script>
    {% endif %}
</head>
<body class="facade">
    <a href="#main" class="skip-link">Zum Inhalt springen</a>

    {% set current_path = app.request.baseUrl ~ app.request.pathInfo %}

    <header class="frame site-head">
        <a href="{{ path('app_homepage') }}" class="site-head-logo" aria-label="Startseite">
            {{ include('partials/_logo.html.twig') }}
        </a>
        <nav class="tabs" aria-label="Bereiche">
            {% for page in pages %}
                <a href="{{ path(page.route) }}"{% if current_path == path(page.route) %} aria-current="page"{% endif %}>{{ page.label }}</a>
            {% endfor %}
        </nav>
    </header>

    <main id="main" class="frame site-main" tabindex="-1">
        {% block cover %}{% endblock %}
        {% block content %}{% endblock %}
    </main>

    <footer class="site-foot">
        <div class="site-foot-tridents" aria-hidden="true"></div>
        <div class="site-foot-line">
            <div class="frame site-foot-row">
                <p>© {{ 'now'|date('Y') }} Marcel Kraus</p>
                <nav aria-label="Rechtliches">
                    <a href="{{ path('app_imprint') }}">Impressum</a> · <a href="{{ path('app_data_privacy') }}">Datenschutz</a>
                </nav>
            </div>
        </div>
    </footer>

    {% block javascript %}{% endblock %}
</body>
</html>
